generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm] // pg_trgm for fuzzy text search
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               UserRole        @default(USER)
  bio                String?         @db.Text
  university         String?
  major              String?
  graduationYear     Int?
  onboarded          Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  lastActiveAt       DateTime        @default(now())
  avatar             String?
  coverPhoto         String?
  currentYear        String?
  dateOfBirth        DateTime?
  gender             Gender?
  githubUrl          String?
  linkedinUrl        String?
  location           String?
  phoneNumber        String?         @unique // prevent duplicate phone
  preferredStudyTime String?
  profileCompleted   Boolean         @default(false)
  studyGoals         String[]        @default([])
  subjects           String[]        @default([])
  twitterUrl         String?
  websiteUrl         String?

  // Account Status
  isActive           Boolean         @default(true) // soft delete / ban
  isSuspended        Boolean         @default(false)
  suspendedAt        DateTime?
  suspendedReason    String?
  deletedAt          DateTime?       // soft delete timestamp

  // AI Usage Tracking
  aiTokensUsed       Int             @default(0)
  aiTokensLimit      Int             @default(100000)
  aiTokensResetAt    DateTime?       // when to reset token count

  // Social Features — counters maintained via transactions
  followersCount     Int             @default(0)
  followingCount     Int             @default(0)
  isOnline           Boolean         @default(false)
  lastSeenAt         DateTime        @default(now())

  // Relations
  accounts           Account[]
  sessions           Session[]
  materials          Material[]      @relation("UserMaterials")
  materialsSharedBy  MaterialShare[] @relation("SharedByUser")
  sharedMaterials    MaterialShare[] @relation("SharedMaterials")
  aiConversations    AiConversation[] @relation("UserConversations")

  // Social Relations
  followers              Follow[]              @relation("Following")
  following              Follow[]              @relation("Follower")
  publicMessages         PublicMessage[]        @relation("PublicMessages")
  privateConversations1  PrivateConversation[] @relation("PrivateUser1")
  privateConversations2  PrivateConversation[] @relation("PrivateUser2")
  privateMessages        PrivateMessage[]      @relation("PrivateMessages")
  posts                  Post[]                @relation("Posts")
  postLikes              PostLike[]            @relation("PostLikes")
  comments               Comment[]             @relation("Comments")

  // Notifications
  notifications          Notification[]        @relation("UserNotifications")
  notificationsTriggered Notification[]        @relation("ActorNotifications")

  // Study Groups
  createdGroups        StudyGroup[]        @relation("CreatedGroups")
  groupMemberships     GroupMember[]       @relation("GroupMemberships")
  sharedGroupMaterials GroupMaterial[]     @relation("SharedGroupMaterials")
  groupInvitations     GroupInvitation[]   @relation("GroupInvitations")
  sentGroupInvitations GroupInvitation[]   @relation("SentGroupInvitations")
  groupJoinRequests    GroupJoinRequest[]  @relation("GroupJoinRequests")

  // Reporting
  reportsFiled         Report[]            @relation("ReportsFiled")
  reportsReceived      Report[]            @relation("ReportsReceived")

  @@index([email])
  @@index([role])
  @@index([lastActiveAt])
  @@index([isActive, role])
  @@index([university])
  @@index([major])
  @@index([subjects])
  @@index([isOnline, lastSeenAt])
  @@index([createdAt])
  @@index([deletedAt]) // for soft delete queries
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?  // track device info
  ipAddress    String?  // track login location

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  token      String    @unique
  type       TokenType @default(EMAIL_VERIFICATION)
  expires    DateTime
  used       Boolean   @default(false) // prevent token reuse
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([identifier, token])
  @@index([expires])
  @@index([type, identifier])
  @@map("verification_tokens")
}

// ============================================
// MATERIALS & CONTENT
// ============================================

model Material {
  id               String             @id @default(cuid())
  title            String
  description      String?            @db.Text
  type             MaterialType
  fileUrl          String
  fileName         String
  fileSize         Int
  mimeType         String
  userId           String
  subject          String?
  tags             String[]           @default([])
  status           MaterialStatus     @default(PENDING)
  visibility       MaterialVisibility @default(PRIVATE)

  // Processing
  isProcessed      Boolean            @default(false)
  processedAt      DateTime?
  processingStatus ProcessingStatus   @default(PENDING)
  processingError  String?            @db.Text
  chunkCount       Int?

  // Stats
  viewCount        Int                @default(0)
  downloadCount    Int                @default(0)
  shareCount       Int                @default(0)

  // Timestamps
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  user             User               @relation("UserMaterials", fields: [userId], references: [id], onDelete: Cascade)
  sharedWith       MaterialShare[]    @relation("MaterialShares")
  chunks           MaterialChunk[]    @relation("MaterialChunks")
  groupMaterials   GroupMaterial[]    @relation("GroupMaterials")

  @@index([userId])
  @@index([subject])
  @@index([status])
  @@index([visibility])
  @@index([processingStatus])
  @@index([createdAt])
  @@index([userId, visibility, createdAt]) // user's materials feed
  @@index([subject, visibility, createdAt]) // subject browse
  @@index([tags]) // tag-based search
  @@index([type, status]) // filter by type and status
  @@map("materials")
}

model MaterialShare {
  id               String    @id @default(cuid())
  materialId       String
  sharedWithUserId String
  sharedByUserId   String
  canDownload      Boolean   @default(true)
  canEdit          Boolean   @default(false)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?

  material         Material  @relation("MaterialShares", fields: [materialId], references: [id], onDelete: Cascade)
  sharedBy         User      @relation("SharedByUser", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWithUser   User      @relation("SharedMaterials", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([materialId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([materialId])
  @@index([sharedByUserId])
  @@index([expiresAt]) // cleanup expired shares
  @@map("material_shares")
}

model MaterialChunk {
  id          String                       @id @default(cuid())
  materialId  String
  chunkText   String                       @map("chunk_text") @db.Text
  chunkIndex  Int                          @map("chunk_index")
  embedding   Unsupported("vector(3072)")
  metadata    Json?                        @default("{}")
  tokenCount  Int?                         // track token size per chunk
  createdAt   DateTime                     @default(now()) @map("created_at")

  material    Material @relation("MaterialChunks", fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex]) // prevent duplicate chunks
  @@index([materialId], map: "material_chunks_material_id_idx")
  @@index([chunkIndex])
  @@map("material_chunks")
}

// ============================================
// AI CONVERSATIONS
// ============================================

model AiConversation {
  id             String      @id @default(cuid())
  title          String      @default("New Conversation")
  userId         String
  materialIds    String[]    @default([])
  model          String      @default("gemini-pro")
  temperature    Float       @default(0.7)
  totalTokens    Int         @default(0) // running total for conversation
  messageCount   Int         @default(0)
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lastMessageAt  DateTime?

  user           User        @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages       AiMessage[]

  @@index([userId])
  @@index([lastMessageAt])
  @@index([createdAt])
  @@index([userId, isArchived, lastMessageAt]) // active conversations
  @@map("ai_conversations")
}

model AiMessage {
  id               String         @id @default(cuid())
  conversationId   String
  role             AiMessageRole
  content          String         @db.Text
  sources          Json?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?           // track API response time
  createdAt        DateTime       @default(now())

  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([conversationId, createdAt]) // message history
  @@map("ai_messages")
}

// ============================================
// SOCIAL FEATURES
// ============================================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt]) // recent follows
  @@map("follows")
}

// ============================================
// PUBLIC CHAT
// ============================================

model PublicChannel {
  id          String          @id @default(cuid())
  name        String          @unique // prevent duplicate channel names
  topic       String?         @db.Text
  subject     String?
  isActive    Boolean         @default(true)
  isArchived  Boolean         @default(false)
  messages    PublicMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([subject])
  @@index([isActive])
  @@index([isActive, isArchived]) // active non-archived channels
  @@map("public_channels")
}

model PublicMessage {
  id          String        @id @default(cuid())
  channelId   String
  channel     PublicChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("PublicMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content     String        @db.Text
  attachments Json?
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([expiresAt])
  @@index([channelId, isDeleted, createdAt]) // visible messages
  @@map("public_messages")
}

// ============================================
// PRIVATE CHAT
// ============================================

model PrivateConversation {
  id               String           @id @default(cuid())
  user1Id          String
  user2Id          String
  user1            User             @relation("PrivateUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2            User             @relation("PrivateUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages         PrivateMessage[]
  lastMessageAt    DateTime?
  lastMessageText  String?          @db.VarChar(255) // limit preview length
  unreadCount1     Int              @default(0) // unread for user1
  unreadCount2     Int              @default(0) // unread for user2
  isBlocked        Boolean          @default(false)
  blockedBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt])
  @@index([user2Id, lastMessageAt])
  @@index([lastMessageAt])
  @@map("private_conversations")
}

model PrivateMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   PrivateConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation("PrivateMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String              @db.Text
  attachments    Json?
  status         MessageStatus       @default(SENT)
  isRead         Boolean             @default(false)
  readAt         DateTime?
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, isDeleted, createdAt]) // visible messages
  @@index([conversationId, isRead]) // unread count queries
  @@map("private_messages")
}

// ============================================
// EXPLORER FEED
// ============================================

model Post {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation("Posts", fields: [authorId], references: [id], onDelete: Cascade)
  caption     String?   @db.Text
  images      Json?
  materialId  String?
  likesCount  Int       @default(0)
  commentCount Int      @default(0) // denormalized counter
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  likes       PostLike[]  @relation("PostLikes")
  comments    Comment[]   @relation("PostComments")

  @@index([authorId])
  @@index([createdAt])
  @@index([authorId, isDeleted, createdAt]) // user feed
  @@index([isDeleted, createdAt]) // explore feed
  @@index([likesCount, createdAt]) // trending
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId]) // one like per user per post
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("Comments", fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  parentId  String?  // for nested replies
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  content   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?        // when it was read
  createdAt DateTime         @default(now())

  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt]) // unread notifications
  @@index([userId, createdAt])
  @@index([type])
  @@index([createdAt]) // cleanup old notifications
  @@map("notifications")
}

// ============================================
// STUDY GROUPS
// ============================================

model StudyGroup {
  id            String       @id @default(cuid())
  name          String
  description   String?      @db.Text
  subject       String
  tags          String[]     @default([])
  privacy       GroupPrivacy @default(PUBLIC)
  creatorId     String
  creator       User         @relation("CreatedGroups", fields: [creatorId], references: [id], onDelete: Cascade)
  maxMembers    Int          @default(50)
  memberCount   Int          @default(0)
  materialCount Int          @default(0)
  avatar        String?
  coverImage    String?
  settings      Json?        @default("{\"allowInvites\": true, \"allowMaterialSharing\": true}")
  chatChannelId String?      @unique // one channel per group
  isArchived    Boolean      @default(false)
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members      GroupMember[]
  materials    GroupMaterial[]
  invitations  GroupInvitation[]
  joinRequests GroupJoinRequest[]

  @@index([subject])
  @@index([privacy])
  @@index([creatorId])
  @@index([privacy, subject, createdAt])
  @@index([tags]) // tag-based group search
  @@index([memberCount]) // popular groups
  @@index([isArchived, privacy, createdAt]) // active groups browse
  @@map("study_groups")
}

model GroupMember {
  id           String     @id @default(cuid())
  groupId      String
  group        StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role         GroupRole  @default(MEMBER)
  joinedAt     DateTime   @default(now())
  lastActiveAt DateTime   @default(now())
  isMuted      Boolean    @default(false) // mute notifications

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, role])
  @@index([userId, lastActiveAt]) // user's active groups
  @@map("group_members")
}

model GroupMaterial {
  id         String     @id @default(cuid())
  groupId    String
  group      StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  materialId String
  material   Material   @relation("GroupMaterials", fields: [materialId], references: [id], onDelete: Cascade)
  sharedBy   String
  sharer     User       @relation("SharedGroupMaterials", fields: [sharedBy], references: [id], onDelete: Cascade)
  sharedAt   DateTime   @default(now())

  @@unique([groupId, materialId])
  @@index([groupId, sharedAt])
  @@index([materialId])
  @@index([sharedBy])
  @@map("group_materials")
}

model GroupInvitation {
  id            String           @id @default(cuid())
  groupId       String
  group         StudyGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUserId String
  invitedUser   User             @relation("GroupInvitations", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     String
  inviter       User             @relation("SentGroupInvitations", fields: [invitedBy], references: [id], onDelete: Cascade)
  status        InvitationStatus @default(PENDING)
  message       String?          @db.Text // invitation message
  expiresAt     DateTime
  respondedAt   DateTime?        // when accepted/rejected
  createdAt     DateTime         @default(now())

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([groupId, status])
  @@index([expiresAt]) // cleanup expired invitations
  @@map("group_invitations")
}

model GroupJoinRequest {
  id         String        @id @default(cuid())
  groupId    String
  group      StudyGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation("GroupJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  message    String?       @db.Text
  status     RequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId])
  @@index([status, createdAt]) // pending requests queue
  @@map("group_join_requests")
}

// ============================================
// REPORTING & MODERATION
// ============================================

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId    String       // ID of reported entity
  targetType  ReportTarget // what type of entity
  targetUserId String?     // user who owns the reported content
  targetUser   User?       @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?      @db.Text
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([targetType, targetId])
  @@map("reports")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaterialType {
  PDF
  DOCUMENT
  PRESENTATION
  SPREADSHEET
  IMAGE
  VIDEO
  AUDIO
  TEXT
  OTHER
}

enum MaterialStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MaterialVisibility {
  PUBLIC
  PRIVATE
  GROUP_ONLY
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum NotificationType {
  LIKE
  FOLLOW
  MESSAGE
  COMMENT
  SYSTEM
  POST
  SHARE
  GROUP_INVITE
  SUGGEST_USER
  SUGGEST_GROUP
  JOIN_REQUEST
  MENTION
  GROUP_UPDATE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTarget {
  USER
  POST
  COMMENT
  MESSAGE
  MATERIAL
  GROUP
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  COPYRIGHT
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}